@model IEnumerable<Dierentuin.Models.Domain.Animal>

@{
    ViewData["Title"] = "Animals";
}

<h1>Animals</h1>


<table class="table table-striped">
    <thead>
        <a asp-action="Create"
           class="btn btn-success mb-3">
            Add New Animal
        </a>

        <tr>
            <th>Name</th>
            <th>Species</th>
            <th>Diet</th>
            <th>Activity</th>
            <th>Enclosure</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var animal in Model)
        {
            <tr>
                <td>@animal.Name</td>
                <td>@animal.Species</td>
                <td>@animal.DietaryClass</td>
                <td>@animal.ActivityPattern</td>
                <td>@(animal.Enclosure?.Name ?? "—")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@animal.Id" class="btn btn-sm btn-primary">
                        Details
                    </a>
                </td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@animal.Id"
                       class="btn btn-sm btn-warning ms-1">
                        Edit
                    </a>

                </td>

            </tr>
        }
    </tbody>
</table>
